@article{Cavaliere2022,
   abstract = {Under what conditions can artificial intelligence contribute to political processes without undermining their legitimacy? Thanks to the ever-growing availability of data and the increasing power of decision-making algorithms, the future of political institutions is unlikely to be anything similar to what we have known throughout the last century, possibly with parliaments deprived of their traditional authority and public decision-making processes largely unaccountable. This paper discusses and challenges these concerns by suggesting a theoretical framework under which algorithmic decision-making is compatible with democracy and, most relevantly, can offer a viable solution to counter the rise of populist rhetoric in the governance arena. Such a framework is based on three pillars: (1) understanding the civic issues that are subjected to automated decision-making; (2) controlling the issues that are assigned to AI; and (3) evaluating and challenging the outputs of algorithmic decision-making.},
   author = {Paolo Cavaliere and Graziella Romeo},
   doi = {10.1017/err.2021.57},
   issn = {21908249},
   issue = {3},
   journal = {European Journal of Risk Regulation},
   keywords = {artificial intelligence,decision-making,democracy,political rights},
   month = {9},
   pages = {421-442},
   publisher = {Cambridge University Press},
   title = {From Poisons to Antidotes: Algorithms as Democracy Boosters},
   volume = {13},
   year = {2022}
}
@article{Dan2019,
   abstract = {Concerns have been raised over AI-generated deepfakes and their impact on democracy. Unlike earlier forms of disinformation relying on text or traditional video-editing techniques (cheapfakes), deepfakes employ artificial intelligence, provoking speculations that they may be even more persuasive and harder to debunk. Using an experiment with a multiple-message design (N = 2,085), we found that fake videos suggesting a sex, corruption, or prejudice scandal—but not text-only fakes—elicited substantial reputational damage for an innocent politician, regardless of whether the underlying technique was “cheap” or “deep.” This was visible in altered attitudes, emotions, and voting intentions. However, exposure to a journalistic fact-check substantially reduced and even eliminated the detrimental effects. These findings have important implications for our theoretical understanding related to the effects of and mitigation strategies for deepfakes. While clearly highlighting the significant persuasive potential of deepfakes (and visual disinformation in general), the present study paints a more nuanced picture than was previously possible.},
   author = {Viorela Dan},
   doi = {10.1177/19401612251317766},
   issn = {19401620},
   issue = {3},
   journal = {International Journal of Press/Politics},
   keywords = {AI,artificial intelligence,cheapfakes,deepfakes,fact-checking,literacy-based fact-checks,visual disinformation},
   month = {9},
   pages = {525-550},
   publisher = {SAGE Publications Inc.},
   title = {Deepfakes as a Democratic Threat: Experimental Evidence Shows Noxious Effects That Are Reducible Through Journalistic Fact Checks},
   volume = {31},
   year = {2019}
}
@article{Bhandari2025,
   abstract = {Deepfakes represent a transformative yet contentious advancement in artificial intelligence (AI), enabling the creation of hyper-realistic manipulations of digital content. While their potential for positive applications in education, entertainment, and accessibility is significant, their misuse poses grave risks to personal privacy, societal trust, and democratic processes. This paper examines the development, applications, and ethical challenges of deepfakes, emphasizing the need for a balanced governance approach to mitigate their negative impacts. By leveraging agency theory and moral responsibility theory, the study underscores the shared accountability of developers, policymakers, and end-users in managing deepfake technologies responsibly. It proposes a combination of technical solutions, regulatory measures, and ethical education to safeguard against malicious uses while fostering innovation. Through this comprehensive analysis, the paper offers insights into addressing the dual-use nature of deepfakes and ensuring their integration aligns with societal values and trust.},
   author = {Rajat Bhandari and Shraddha Bhandari},
   doi = {10.1080/07366981.2025.2484863},
   issn = {19361009},
   issue = {9},
   journal = {EDPACS},
   pages = {21-31},
   publisher = {Taylor and Francis Ltd.},
   title = {Artificial intelligence: understanding deepfakes},
   volume = {70},
   year = {2025}
}
@article{Lim2026,
   abstract = {Democratic decision-making is difficult. Representatives often fail to represent the preferences of their constituents, and directly consulting members of the public can be costly. Inspired by these difficulties, several scholars have discussed the use of artificial intelligence (AI) models to support democratic decision-making. One such particular application is the use of AI to represent public policy preferences by predicting them. In this paper, we perform an analysis on the different ways AI models can be used to represent public policy preferences. We make distinctions between using AI as epistemic tools and for procedure; group and individual predictions; and predictions about preferences and inferences about values. We also describe how AI models can help policymakers screen policies for potential worries and objections, double-check any beliefs they have about the acceptability of their policies, and justify policy proposals. We also consider a number of worries about the use of AI in policymaking. We argue that these worries, while legitimate, can be mitigated or avoided in the way we have proposed the use of AI.},
   author = {James Edgar Lim and Julian Savulescu},
   doi = {10.1007/s00146-025-02474-9},
   issn = {14355655},
   issue = {1},
   journal = {AI and Society},
   keywords = {Artificial intelligence (AI),Augmented democracy,Collective reflective equilibrium,Democracy,Preference prediction},
   month = {1},
   pages = {135-149},
   publisher = {Springer Science and Business Media Deutschland GmbH},
   title = {AI preference prediction and policy making},
   volume = {41},
   year = {2026}
}
@techReport{Kay2024,
   abstract = {This paper investigates how generative AI can potentially undermine the integrity of collective knowledge and the processes we rely on to acquire, assess, and trust information, posing a significant threat to our knowledge ecosystem and democratic discourse. Grounded in social and political philosophy , we introduce the concept of generative algorithmic epistemic injustice. We identify four key dimensions of this phenomenon: amplified and manipulative testimonial injustice , along with hermeneutical ignorance and access injustice. We illustrate each dimension with real-world examples that reveal how generative AI can produce or amplify misinforma-tion, perpetuate representational harm, and create epistemic inequities, particularly in multilingual contexts. By highlighting these injustices, we aim to inform the development of epistemically just generative AI systems, proposing strategies for resistance, system design principles, and two approaches that leverage generative AI to foster a more equitable information ecosystem, thereby safeguarding democratic values and the integrity of knowledge production.},
   author = {Jackie Kay and Atoosa Kasirzadeh and Shakir Mohamed},
   keywords = {AIES: AI Bias,AIES: Epistemic Justice,AIES: Generative AI,AIES: Misinformation},
   title = {Epistemic Injustice in Generative AI},
   url = {www.aaai.org},
   year = {2024}
}
